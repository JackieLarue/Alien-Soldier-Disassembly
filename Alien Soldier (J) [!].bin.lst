                movea.l (a0,d3.w),a0
jump3:                                  ; CODE XREF: stop_sfx+70   j stop_sfx+76   j
                bclr    #_write_protect,(a0)
                bset    #_null,(a0)
                cmpi.b  #$E0,channelno(a0)

input_read_p1:                          ; CODE XREF: input_read+A   p
                lea     (CRTL1_DOWN).w,a1
                lea     ((IO_CT1_DATA+1)).l,a2
                lea     (CRTL1_FF20).w,a3
                bsr.w   input_read_port
                move.b  d0,(CRTL1_STATE).w
                cmpi.b  #$D,d0          ; skipping this check and jmp straight to sub0 prevents pressing both left + right triggering select for some reason
                beq.w   input_update_state
                bra.w   input_clear_data
; End of function input_read_p1


input_read_p2:                          ; CODE XREF: input_read+E   p
                lea     (CRTL2_DOWN).w,a1
                lea     ((IO_CT2_DATA+1)).l,a2
                lea     (CRTL2_FF21).w,a3
                bsr.w   input_read_port
                move.b  d0,(CRTL2_STATE).w
                cmpi.b  #$D,d0          ; ditto for p2
                beq.w   input_update_state
input_clear_data:                       ; CODE XREF: input_read_p1+1E   j
                clr.b   (a1)
                clr.b   CRTL_DATA_PRESSED(a1)
                clr.b   CRTL_DATA_RELEASED(a1)

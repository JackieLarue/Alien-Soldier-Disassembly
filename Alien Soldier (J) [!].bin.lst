                move.b  noisetype(a0),(VDP_PSG).l
next:                                   ; CODE XREF: stop_sfx+14   j stop_sfx+62   j ...
                adda.w  #flgvol,a5
                dbf     d6,loop
                rts
; End of function stop_sfx


stop_back_sfx:                          ; CODE XREF: play_snd_id+6C   j play_song+E   p
                                        ; DATA XREF: ...

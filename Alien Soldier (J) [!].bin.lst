gfx_queue_txt_wrapped:                  ; CODE XREF: region_check+60   p region_check+74   p ...
                movea.w (DMA_QUEUE_SRC_F70E).w,a1
                moveq   #0,d7
read_bytestream:                        ; CODE XREF: gfx_queue_txt_wrapped+18   j
                moveq   #0,d2           ; zero out d2
                move.b  (a0)+,d2        ; copy byte from src addr into d2
                cmpi.b  #b_EOS,d2       ; if byte == 0xFF (m_EOS)
                beq.s   write_prep      ; branch to write_prep
                asl.w   #1,d2           ; double d2
                add.w   d0,d2           ; add d0 and char byte, store in d2
                move.w  d2,(a1)+        ; copy d2 into DMA_DATA, increment offset a1
                addq.w  #1,d7           ; increment dma len by 1
                bra.s   read_bytestream ; loop
; ---------------------------------------------------------------------------
write_prep:                             ; CODE XREF: gfx_queue_txt_wrapped+E   j
                move.w  d7,d3           ; move loop_counter / dma len(d7) into d3
                subq.w  #1,d3           ; subtract 1 from d3
                movea.w (DMA_QUEUE_SRC_F70E).w,a0
write_loop:                             ; CODE XREF: gfx_queue_txt_wrapped+28   j
                move.w  (a0)+,d0        ; copy word from DMA_DATA location into d0, increment ptr
                addq.w  #1,d0           ; add 1
                move.w  d0,(a1)+        ; append d0 to end of DMA_SRC_DATA
                dbf     d3,write_loop
after_loop:                             ; move dma len(d7) into d3
                move.w  d7,d3
                bsr.w   dma_queue_prepend_txt_4594
                addi.w  #$80,d4         ; add 0x80 to dest_offset
                move.w  d4,d5
                andi.w  #%1101111111111111,d5
                cmpi.w  #$5000,d5       ; if D5 less than $5000
                bmi.s   end_of_sub      ; branch
                subi.w  #$1000,d4       ; otherwise subtract $1000 from d4
end_of_sub:                             ; CODE XREF: gfx_queue_txt_wrapped+40   j
                move.w  d7,d3           ; again move dma len(d7) into d3
                bra.w   dma_queue_prepend_txt_4594 ; one last append

input_update_state:                     ; CODE XREF: input_read_p1+1A   j input_read_p2+1A   j
                move.b  #0,(a2)
                nop
                nop
                move.b  (a2),d0
                add.b   d0,d0
                add.b   d0,d0
                andi.b  #%11000000,d0
                move.b  #$40,(a2) ; '@' ; TH to 1
                nop
                nop
                move.b  (a2),d1
                andi.b  #%00111111,d1
                or.b    d1,d0
                not.b   d0
                bsr.w   controller_sub_3462
                move.b  (a1),d1
                move.b  d1,d2
                eor.b   d0,d2
                move.b  d0,(a1)
                and.b   d2,d1
                move.b  d1,CRTL_DATA_RELEASED(a1)
                and.b   d2,d0
                move.b  d0,CRTL_DATA_PRESSED(a1)
                rts
; End of function input_update_state


controller_sub_3462:                    ; CODE XREF: input_update_state+24   p
                btst    #6,(CRTL_FLAG).w
                beq.w   end_3498
                move.b  d0,d1
                move.b  #button_A,d2
                move.b  (a3),d3
                bsr.w   input_test_and_set_bit
                move.b  #button_B,d2
                move.b  CRTL_DATA_PRESSED(a3),d3
                bsr.w   input_test_and_set_bit
                move.b  #button_C,d2
                move.b  CRTL_DATA_RELEASED(a3),d3
input_test_and_set_bit:                 ; CODE XREF: controller_sub_3462+12   p controller_sub_3462+1E   p
                btst    d3,d1
                beq.w   clr
                bset    d2,d0
                rts

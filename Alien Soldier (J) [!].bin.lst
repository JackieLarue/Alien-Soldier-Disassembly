input_read:                             ; CODE XREF: VBLANK+B8   p input_read+8   j
                bset    #z80_bus_off,(IO_Z80BUS).l
                bne.s   input_read
                bsr.w   input_read_p1
                bsr.w   input_read_p2
wait_z80_clr:                           ; CODE XREF: input_read+1A   j
                bclr    #z80_bus_off,(IO_Z80BUS).l

clr:                                    ; CODE XREF: controller_sub_3462+2C   j
                bclr    d2,d0
end_3498:                               ; CODE XREF: controller_sub_3462+6   j
                rts
; End of function controller_sub_3462


; input: a3- has address of either controller 1 or 2 data
; returns: d0- controller data proper
input_read_port:                        ; CODE XREF: input_read_p1+E   p input_read_p2+E   p
                move.b  #$40,(a2) ; '@' ; TH to 1
                nop
                nop
                move.b  (a2),d0
                move.b  d0,d1
                lsl.b   #1,d1
                or.b    d1,d0
                move.b  d0,d1
                andi.b  #8,d0
                lsl.b   #1,d1
                andi.b  #4,d1
                move.b  #0,(a2)         ; TH to 0
                nop
                nop
                move.b  (a2),d2
                move.b  d2,d3
                lsr.b   #1,d3
                or.b    d3,d2
                move.b  d2,d3
                lsr.b   #1,d2
                andi.b  #2,d2
                andi.b  #1,d3
                or.b    d1,d0
                or.b    d2,d0
                or.b    d3,d0
                rts
; End of function input_read_port


